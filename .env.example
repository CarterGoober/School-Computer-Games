# Copy to .env for local use or set these in your host's dashboard.
# Never commit a real .env or a real secret.

PORT=8787
HOST=0.0.0.0

# Public hostname Caddy should serve (used by docker-compose.yml).
# Oracle free VM example: 140-238-1-2.sslip.io
CHROMA_DOMAIN=

# 32+ random bytes. Keep it stable; changing it invalidates every session token.
# Generate with: openssl rand -hex 32
CHROMA_SECRET=

# Persistent directory for accounts.json (and the generated secret if CHROMA_SECRET is empty).
CHROMA_DATA_DIR=/data

# Extra browser origins allowed to call the API and open the WebSocket.
# Same-origin and localhost are always allowed.
CHROMA_ALLOWED_ORIGINS=https://afterclass-garage-ashen-vale.adoredcarat1.chatgpt.com

# CSP frame-ancestors for HTML. Add every site origin that may iframe the game.
CHROMA_FRAME_ANCESTORS='self' https://afterclass-garage-ashen-vale.adoredcarat1.chatgpt.com

# Matchmaking behaviour.
CHROMA_BOTS=1
CHROMA_BOT_DELAY_MS=6000
