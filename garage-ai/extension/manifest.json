{
  "manifest_version": 3,
  "name": "Garage AI",
  "version": "0.1.0",
  "description": "A free study companion. Screen previews are sent only with your confirmation.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://gvurobdhsvcvdywdsgne.supabase.co/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Garage AI"
  },
  "options_page": "options.html",
  "commands": {
    "open-garage-ai": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Open Garage AI"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "ui.css",
        "panel.js",
        "vendor/*"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "key": ""
}